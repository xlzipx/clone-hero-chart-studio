{
  "name": "chartstudio",
  "productName": "ChartStudio",
  "version": "0.102.0",
  "description": "Clone Hero chart editor with its own engine (drums + 5-fret guitar/bass)",
  "main": "src/main.js",
  "author": "ZIPEEK",
  "license": "MIT",
  "homepage": "https://github.com/xlzipx/clone-hero-chart-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlzipx/clone-hero-chart-studio.git"
  },
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.zipeek.chartstudio",
    "productName": "ChartStudio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ChartStudio-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
